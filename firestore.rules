rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. Global Safety Net (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. Hardened Global Helper Functions
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 4
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCategoryId(id) {
      return id is string
        && id.size() >= 2
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Pure token-based bootstrapped admin check (zero DB lookups — safe for `list`)
    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email.lower() == 'amalj7767@gmail.com';
    }

    // Full admin check including delegated /admins/{uid} registry (for single-doc ops)
    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // =========================================================================
    // 3. Entity Validation Blueprints (Matched verbatim to firebase-blueprint.json)
    // =========================================================================
    function isValidVisitorSession(data, sessionId) {
      return data.keys().hasAll([
          'sessionId',
          'visitorId',
          'visitNumber',
          'isReturning',
          'language',
          'deviceType',
          'screenCategory',
          'referrerSource',
          'currentStep',
          'anglesGeneratedCount',
          'breakdownsGeneratedCount',
          'ttsPlaysCount',
          'activeDurationSec',
          'dayKey',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'sessionId',
          'visitorId',
          'visitNumber',
          'isReturning',
          'language',
          'deviceType',
          'screenCategory',
          'referrerSource',
          'currentStep',
          'anglesGeneratedCount',
          'breakdownsGeneratedCount',
          'ttsPlaysCount',
          'activeDurationSec',
          'dayKey',
          'isLoggedIn',
          'userEmail',
          'createdAt',
          'updatedAt'
        ])
        && (!('isLoggedIn' in data) || data.isLoggedIn is bool)
        && (!('userEmail' in data) || (
          data.userEmail is string
          && data.userEmail.size() <= 128
          && (
            data.userEmail == ''
            || (isVerifiedUser() && data.userEmail.lower() == request.auth.token.email.lower())
          )
        ))
        && isValidId(data.sessionId)
        && data.sessionId == sessionId
        && isValidId(data.visitorId)
        && data.visitNumber is int
        && data.visitNumber >= 1
        && data.visitNumber <= 100000
        && data.isReturning is bool
        && data.language is string
        && data.language.size() <= 5
        && data.language in ['ml', 'en', 'hi', 'ta', 'kn', 'te']
        && data.deviceType is string
        && data.deviceType.size() <= 16
        && data.deviceType in ['mobile', 'tablet', 'desktop']
        && data.screenCategory is string
        && data.screenCategory.size() >= 3
        && data.screenCategory.size() <= 32
        && data.referrerSource is string
        && data.referrerSource.size() >= 1
        && data.referrerSource.size() <= 64
        && data.currentStep is string
        && data.currentStep.size() <= 16
        && data.currentStep in ['input', 'options', 'prompts', 'editor', 'admin']
        && data.anglesGeneratedCount is int
        && data.anglesGeneratedCount >= 0
        && data.anglesGeneratedCount <= 1000
        && data.breakdownsGeneratedCount is int
        && data.breakdownsGeneratedCount >= 0
        && data.breakdownsGeneratedCount <= 1000
        && data.ttsPlaysCount is int
        && data.ttsPlaysCount >= 0
        && data.ttsPlaysCount <= 1000
        && data.activeDurationSec is int
        && data.activeDurationSec >= 0
        && data.activeDurationSec <= 86400
        && data.dayKey is string
        && data.dayKey.size() == 10
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 128
        && data.role is string
        && data.role.size() <= 16
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidUserAccount(data, uid) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'loginCount',
          'savedStoriesCount',
          'lastDayKey',
          'createdAt',
          'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'loginCount',
          'savedStoriesCount',
          'lastDayKey',
          'createdAt',
          'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 128
        && data.email.lower() == request.auth.token.email.lower()
        && data.displayName is string
        && data.displayName.size() <= 128
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.loginCount is int
        && data.loginCount >= 1
        && data.loginCount <= 1000000
        && data.savedStoriesCount is int
        && data.savedStoriesCount >= 0
        && data.savedStoriesCount <= 10000
        && data.lastDayKey is string
        && data.lastDayKey.size() == 10
        && data.lastDayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidSavedStory(data, uid, storyId) {
      return data.keys().hasAll([
          'storyId',
          'ownerUid',
          'ownerEmail',
          'title',
          'storySummary',
          'genre',
          'durationDisplay',
          'durationSeconds',
          'shotCount',
          'shots',
          'angle',
          'partNumber',
          'isAutoSaved',
          'savedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'storyId',
          'ownerUid',
          'ownerEmail',
          'title',
          'storySummary',
          'genre',
          'durationDisplay',
          'durationSeconds',
          'shotCount',
          'shots',
          'angle',
          'partNumber',
          'isAutoSaved',
          'isLoved',
          'savedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && (!('isLoved' in data) || data.isLoved is bool)
        && isValidId(data.storyId)
        && data.storyId == storyId
        && isValidId(data.ownerUid)
        && data.ownerUid == uid
        && data.ownerUid == request.auth.uid
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 128
        && data.ownerEmail.lower() == request.auth.token.email.lower()
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && data.storySummary is string
        && data.storySummary.size() <= 20000
        && data.genre is string
        && data.genre.size() <= 120
        && data.durationDisplay is string
        && data.durationDisplay.size() <= 120
        && data.durationSeconds is int
        && data.durationSeconds >= 1
        && data.durationSeconds <= 86400
        && data.shotCount is int
        && data.shotCount >= 0
        && data.shotCount <= 2000
        && data.shots is list
        && data.shots.size() <= 500
        && (data.shots.size() == 0 || data.shots[0] is map)
        && data.angle is map
        && data.partNumber is int
        && data.partNumber >= 1
        && data.partNumber <= 1000
        && data.isAutoSaved is bool
        && data.savedAtMs is int
        && data.savedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGenerationLog(data, logId) {
      return data.keys().hasAll([
          'logId',
          'visitorId',
          'sessionId',
          'isLoggedIn',
          'userEmail',
          'actionType',
          'language',
          'searchPremise',
          'generatedTitles',
          'selectedStoryTitle',
          'shotCount',
          'dayKey',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'logId',
          'visitorId',
          'sessionId',
          'isLoggedIn',
          'userEmail',
          'actionType',
          'language',
          'searchPremise',
          'generatedTitles',
          'selectedStoryTitle',
          'shotCount',
          'dayKey',
          'createdAt'
        ])
        && isValidId(data.logId)
        && data.logId == logId
        && isValidId(data.visitorId)
        && isValidId(data.sessionId)
        && data.isLoggedIn is bool
        && data.userEmail is string
        && data.userEmail.size() <= 128
        && (
          (!data.isLoggedIn && data.userEmail == '')
          || (data.isLoggedIn && isVerifiedUser() && data.userEmail.lower() == request.auth.token.email.lower())
        )
        && data.actionType is string
        && data.actionType.size() <= 16
        && data.actionType in ['angles', 'prompts']
        && data.language is string
        && data.language.size() <= 5
        && data.language in ['ml', 'en', 'hi', 'ta', 'kn', 'te']
        && data.searchPremise is string
        && data.searchPremise.size() >= 1
        && data.searchPremise.size() <= 5000
        && data.generatedTitles is list
        && data.generatedTitles.size() <= 20
        && (data.generatedTitles.size() == 0 || data.generatedTitles[0] is string)
        && data.selectedStoryTitle is string
        && data.selectedStoryTitle.size() <= 300
        && data.shotCount is int
        && data.shotCount >= 0
        && data.shotCount <= 2000
        && data.dayKey is string
        && data.dayKey.size() == 10
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    function isValidVideoEditLog(data, editId) {
      return data.keys().hasAll([
          'editId',
          'visitorId',
          'sessionId',
          'isLoggedIn',
          'userEmail',
          'actionType',
          'projectTitle',
          'clipCount',
          'resolution',
          'aspectRatio',
          'exportDurationSec',
          'deviceType',
          'dayKey',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'editId',
          'visitorId',
          'sessionId',
          'isLoggedIn',
          'userEmail',
          'actionType',
          'projectTitle',
          'clipCount',
          'resolution',
          'aspectRatio',
          'exportDurationSec',
          'deviceType',
          'dayKey',
          'createdAt'
        ])
        && isValidId(data.editId)
        && data.editId == editId
        && isValidId(data.visitorId)
        && isValidId(data.sessionId)
        && data.isLoggedIn is bool
        && data.userEmail is string
        && data.userEmail.size() <= 128
        && (
          (!data.isLoggedIn && data.userEmail == '')
          || (data.isLoggedIn && isVerifiedUser() && data.userEmail.lower() == request.auth.token.email.lower())
        )
        && data.actionType is string
        && data.actionType.size() <= 24
        && data.actionType in ['open_editor', 'add_media', 'edit_timeline', 'export_video']
        && data.projectTitle is string
        && data.projectTitle.size() <= 200
        && data.clipCount is int
        && data.clipCount >= 0
        && data.clipCount <= 500
        && data.resolution is string
        && data.resolution.size() <= 10
        && data.resolution in ['420p', '720p', '1080p']
        && data.aspectRatio is string
        && data.aspectRatio.size() <= 10
        && data.aspectRatio in ['16:9', '9:16', '1:1', '4:5', '21:9', '4:3']
        && data.exportDurationSec is int
        && data.exportDurationSec >= 0
        && data.exportDurationSec <= 86400
        && data.deviceType is string
        && data.deviceType.size() <= 16
        && data.deviceType in ['mobile', 'tablet', 'desktop']
        && data.dayKey is string
        && data.dayKey.size() == 10
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    function isValidEditorConfigState(data, configId) {
      return data.keys().hasAll([
          'configId',
          'categoriesInitialized',
          'musicLyricsInitialized',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'configId',
          'categoriesInitialized',
          'musicLyricsInitialized',
          'updatedAt'
        ])
        && isValidId(data.configId)
        && data.configId == configId
        && data.categoriesInitialized is bool
        && data.musicLyricsInitialized is bool
        && data.updatedAt is timestamp;
    }

    function isValidEditorCategory(data, categoryId) {
      return data.keys().hasAll([
          'categoryId',
          'label',
          'shortLabel',
          'tab',
          'subCategory',
          'trackNumber',
          'trackName',
          'accentHex',
          'iconKey',
          'orderIndex',
          'isBuiltIn',
          'hasLyricsBoxes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'categoryId',
          'label',
          'shortLabel',
          'tab',
          'subCategory',
          'trackNumber',
          'trackName',
          'accentHex',
          'iconKey',
          'orderIndex',
          'isBuiltIn',
          'hasLyricsBoxes',
          'createdAt',
          'updatedAt'
        ])
        && isValidCategoryId(data.categoryId)
        && data.categoryId == categoryId
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 80
        && data.shortLabel is string
        && data.shortLabel.size() >= 1
        && data.shortLabel.size() <= 24
        && data.tab is string
        && data.tab.size() >= 1
        && data.tab.size() <= 32
        && data.subCategory is string
        && data.subCategory.size() <= 64
        && data.trackNumber is int
        && data.trackNumber >= 1
        && data.trackNumber <= 1000
        && data.trackName is string
        && data.trackName.size() >= 1
        && data.trackName.size() <= 40
        && data.accentHex is string
        && data.accentHex.size() == 7
        && data.accentHex.matches('^#[0-9a-fA-F]{6}$')
        && data.iconKey is string
        && data.iconKey.size() >= 1
        && data.iconKey.size() <= 32
        && data.orderIndex is int
        && data.orderIndex >= 0
        && data.orderIndex <= 10000
        && data.isBuiltIn is bool
        && data.hasLyricsBoxes is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCategoryContentItem(data, itemId) {
      return data.keys().hasAll([
          'itemId',
          'categoryId',
          'title',
          'subtitle',
          'lyrics',
          'badgeText',
          'orderIndex',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'itemId',
          'categoryId',
          'title',
          'subtitle',
          'lyrics',
          'badgeText',
          'orderIndex',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.itemId)
        && data.itemId == itemId
        && isValidCategoryId(data.categoryId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.subtitle is string
        && data.subtitle.size() <= 160
        && data.lyrics is string
        && data.lyrics.size() <= 8000
        && data.badgeText is string
        && data.badgeText.size() <= 40
        && data.orderIndex is int
        && data.orderIndex >= 0
        && data.orderIndex <= 10000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================================
    // 4. Collection Rules
    // =========================================================================

    // Anonymous guest visitor usage telemetry:
    match /visitor_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow delete: if isValidId(sessionId) && isAdmin();

      allow create: if isValidId(sessionId)
        && isValidVisitorSession(incoming(), sessionId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().anglesGeneratedCount <= 10
        && incoming().breakdownsGeneratedCount <= 10
        && incoming().ttsPlaysCount <= 20;

      allow update: if isValidId(sessionId)
        && isValidVisitorSession(incoming(), sessionId)
        && (
          isAdmin()
          || (
            incoming().sessionId == existing().sessionId
            && incoming().visitorId == existing().visitorId
            && incoming().visitNumber == existing().visitNumber
            && incoming().isReturning == existing().isReturning
            && incoming().deviceType == existing().deviceType
            && incoming().screenCategory == existing().screenCategory
            && incoming().referrerSource == existing().referrerSource
            && incoming().dayKey == existing().dayKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().anglesGeneratedCount >= existing().anglesGeneratedCount
            && incoming().anglesGeneratedCount <= existing().anglesGeneratedCount + 10
            && incoming().breakdownsGeneratedCount >= existing().breakdownsGeneratedCount
            && incoming().breakdownsGeneratedCount <= existing().breakdownsGeneratedCount + 10
            && incoming().ttsPlaysCount >= existing().ttsPlaysCount
            && incoming().ttsPlaysCount <= existing().ttsPlaysCount + 20
            && incoming().activeDurationSec >= existing().activeDurationSec
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'language',
              'currentStep',
              'anglesGeneratedCount',
              'breakdownsGeneratedCount',
              'ttsPlaysCount',
              'activeDurationSec',
              'isLoggedIn',
              'userEmail',
              'updatedAt'
            ])
          )
        );
    }

    // Admin registry collection
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isBootstrappedAdmin() || (isVerifiedUser() && request.auth.uid == uid));
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    // Signed-in Google (Gmail) user accounts (PII isolated to Owner + Admin)
    match /user_accounts/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidUserAccount(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidUserAccount(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'loginCount',
          'savedStoriesCount',
          'lastDayKey',
          'lastLoginAt'
        ]);

      allow delete: if isValidId(uid) && (isOwner(uid) || isAdmin());

      // Auto-synced stories, ❤️ favorites & prompts saved to the user's Gmail account
      match /saved_stories/{storyId} {
        allow get: if isValidId(uid) && isValidId(storyId) && (isOwner(uid) || isAdmin());
        allow list: if isValidId(uid) && (
          isBootstrappedAdmin()
          || (isOwner(uid) && existing().ownerUid == request.auth.uid)
        );

        allow create: if isValidId(uid)
          && isValidId(storyId)
          && isOwner(uid)
          && isValidSavedStory(incoming(), uid, storyId)
          && exists(/databases/$(database)/documents/user_accounts/$(uid))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(uid)
          && isValidId(storyId)
          && isOwner(uid)
          && isValidSavedStory(incoming(), uid, storyId)
          && exists(/databases/$(database)/documents/user_accounts/$(uid))
          && incoming().storyId == existing().storyId
          && incoming().ownerUid == existing().ownerUid
          && incoming().ownerEmail == existing().ownerEmail
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'storySummary',
            'genre',
            'durationDisplay',
            'durationSeconds',
            'shotCount',
            'shots',
            'angle',
            'partNumber',
            'isAutoSaved',
            'isLoved',
            'savedAtMs',
            'updatedAt'
          ]);

        allow delete: if isValidId(uid) && isValidId(storyId) && (isOwner(uid) || isAdmin());
      }
    }

    // Append-only search premise & story/prompt generation activity logs (Admin-read only)
    match /generation_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId)
        && isValidGenerationLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }

    // Append-only video editor activity logs across guest & Gmail users (Admin-read only)
    match /video_edit_logs/{editId} {
      allow get: if isValidId(editId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(editId)
        && isValidVideoEditLog(incoming(), editId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(editId) && isAdmin();
    }

    // Editor initialization flags (Public get for client sync, Admin-only writes)
    match /editor_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(configId)
        && isAdmin()
        && isValidEditorConfigState(incoming(), configId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(configId)
        && isAdmin()
        && isValidEditorConfigState(incoming(), configId)
        && incoming().configId == existing().configId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'categoriesInitialized',
          'musicLyricsInitialized',
          'updatedAt'
        ]);
      allow delete: if isValidId(configId) && isAdmin();
    }

    // Public dynamic editor wheel categories (Non-PII, Admin-only writes)
    match /editor_categories/{categoryId} {
      allow get: if isValidCategoryId(categoryId);
      allow list: if true;
      allow create: if isValidCategoryId(categoryId)
        && isAdmin()
        && isValidEditorCategory(incoming(), categoryId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidCategoryId(categoryId)
        && isAdmin()
        && isValidEditorCategory(incoming(), categoryId)
        && incoming().categoryId == existing().categoryId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'label',
          'shortLabel',
          'tab',
          'subCategory',
          'trackNumber',
          'trackName',
          'accentHex',
          'iconKey',
          'orderIndex',
          'isBuiltIn',
          'hasLyricsBoxes',
          'updatedAt'
        ]);
      allow delete: if isValidCategoryId(categoryId) && isAdmin();
    }

    // Public copyable song lyrics & category content boxes (Non-PII, Admin-only writes)
    match /category_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if true;
      allow create: if isValidId(itemId)
        && isAdmin()
        && isValidCategoryContentItem(incoming(), itemId)
        && existsAfter(/databases/$(database)/documents/editor_categories/$(incoming().categoryId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(itemId)
        && isAdmin()
        && isValidCategoryContentItem(incoming(), itemId)
        && exists(/databases/$(database)/documents/editor_categories/$(incoming().categoryId))
        && incoming().itemId == existing().itemId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'categoryId',
          'title',
          'subtitle',
          'lyrics',
          'badgeText',
          'orderIndex',
          'updatedAt'
        ]);
      allow delete: if isValidId(itemId) && isAdmin();
    }
  }
}
