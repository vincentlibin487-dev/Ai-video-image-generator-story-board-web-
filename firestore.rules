rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. Global Safety Net (Default-Deny Catch-All)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 2. Hardened Global Helper Functions
    // =========================================================================
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string
        && id.size() >= 4
        && id.size() <= 128
        && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Pure token-based bootstrapped admin check (zero DB lookups — safe for `list`)
    function isBootstrappedAdmin() {
      return isVerifiedUser()
        && request.auth.token.email.lower() == 'amalj7767@gmail.com';
    }

    // Full admin check including delegated /admins/{uid} registry (for single-doc ops)
    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerifiedUser()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // =========================================================================
    // 3. Entity Validation Blueprints (Matched verbatim to firebase-blueprint.json)
    // =========================================================================
    function isValidVisitorSession(data, sessionId) {
      return data.keys().hasAll([
          'sessionId',
          'visitorId',
          'visitNumber',
          'isReturning',
          'language',
          'deviceType',
          'screenCategory',
          'referrerSource',
          'currentStep',
          'anglesGeneratedCount',
          'breakdownsGeneratedCount',
          'ttsPlaysCount',
          'activeDurationSec',
          'dayKey',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'sessionId',
          'visitorId',
          'visitNumber',
          'isReturning',
          'language',
          'deviceType',
          'screenCategory',
          'referrerSource',
          'currentStep',
          'anglesGeneratedCount',
          'breakdownsGeneratedCount',
          'ttsPlaysCount',
          'activeDurationSec',
          'dayKey',
          'isLoggedIn',
          'userEmail',
          'createdAt',
          'updatedAt'
        ])
        && (!('isLoggedIn' in data) || data.isLoggedIn is bool)
        && (!('userEmail' in data) || (
          data.userEmail is string
          && data.userEmail.size() <= 128
          && (
            data.userEmail == ''
            || (isVerifiedUser() && data.userEmail.lower() == request.auth.token.email.lower())
          )
        ))
        && isValidId(data.sessionId)
        && data.sessionId == sessionId
        && isValidId(data.visitorId)
        && data.visitNumber is int
        && data.visitNumber >= 1
        && data.visitNumber <= 100000
        && data.isReturning is bool
        && data.language is string
        && data.language.size() <= 5
        && data.language in ['ml', 'en', 'hi', 'ta', 'kn', 'te']
        && data.deviceType is string
        && data.deviceType.size() <= 16
        && data.deviceType in ['mobile', 'tablet', 'desktop']
        && data.screenCategory is string
        && data.screenCategory.size() >= 3
        && data.screenCategory.size() <= 32
        && data.referrerSource is string
        && data.referrerSource.size() >= 1
        && data.referrerSource.size() <= 64
        && data.currentStep is string
        && data.currentStep.size() <= 16
        && data.currentStep in ['input', 'options', 'prompts', 'admin']
        && data.anglesGeneratedCount is int
        && data.anglesGeneratedCount >= 0
        && data.anglesGeneratedCount <= 1000
        && data.breakdownsGeneratedCount is int
        && data.breakdownsGeneratedCount >= 0
        && data.breakdownsGeneratedCount <= 1000
        && data.ttsPlaysCount is int
        && data.ttsPlaysCount >= 0
        && data.ttsPlaysCount <= 1000
        && data.activeDurationSec is int
        && data.activeDurationSec >= 0
        && data.activeDurationSec <= 86400
        && data.dayKey is string
        && data.dayKey.size() == 10
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 128
        && data.role is string
        && data.role.size() <= 16
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidUserAccount(data, uid) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'loginCount',
          'savedStoriesCount',
          'lastDayKey',
          'createdAt',
          'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'photoURL',
          'loginCount',
          'savedStoriesCount',
          'lastDayKey',
          'createdAt',
          'lastLoginAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 128
        && data.email.lower() == request.auth.token.email.lower()
        && data.displayName is string
        && data.displayName.size() <= 128
        && data.photoURL is string
        && data.photoURL.size() <= 512
        && data.loginCount is int
        && data.loginCount >= 1
        && data.loginCount <= 1000000
        && data.savedStoriesCount is int
        && data.savedStoriesCount >= 0
        && data.savedStoriesCount <= 10000
        && data.lastDayKey is string
        && data.lastDayKey.size() == 10
        && data.lastDayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidSavedStory(data, uid, storyId) {
      return data.keys().hasAll([
          'storyId',
          'ownerUid',
          'ownerEmail',
          'title',
          'storySummary',
          'genre',
          'durationDisplay',
          'durationSeconds',
          'shotCount',
          'shots',
          'angle',
          'partNumber',
          'isAutoSaved',
          'savedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'storyId',
          'ownerUid',
          'ownerEmail',
          'title',
          'storySummary',
          'genre',
          'durationDisplay',
          'durationSeconds',
          'shotCount',
          'shots',
          'angle',
          'partNumber',
          'isAutoSaved',
          'isLoved',
          'savedAtMs',
          'createdAt',
          'updatedAt'
        ])
        && (!('isLoved' in data) || data.isLoved is bool)
        && isValidId(data.storyId)
        && data.storyId == storyId
        && isValidId(data.ownerUid)
        && data.ownerUid == uid
        && data.ownerUid == request.auth.uid
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 128
        && data.ownerEmail.lower() == request.auth.token.email.lower()
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 300
        && data.storySummary is string
        && data.storySummary.size() <= 20000
        && data.genre is string
        && data.genre.size() <= 120
        && data.durationDisplay is string
        && data.durationDisplay.size() <= 120
        && data.durationSeconds is int
        && data.durationSeconds >= 1
        && data.durationSeconds <= 86400
        && data.shotCount is int
        && data.shotCount >= 0
        && data.shotCount <= 2000
        && data.shots is list
        && data.shots.size() <= 500
        && (data.shots.size() == 0 || data.shots[0] is map)
        && data.angle is map
        && data.partNumber is int
        && data.partNumber >= 1
        && data.partNumber <= 1000
        && data.isAutoSaved is bool
        && data.savedAtMs is int
        && data.savedAtMs >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGenerationLog(data, logId) {
      return data.keys().hasAll([
          'logId',
          'visitorId',
          'sessionId',
          'isLoggedIn',
          'userEmail',
          'actionType',
          'language',
          'searchPremise',
          'generatedTitles',
          'selectedStoryTitle',
          'shotCount',
          'dayKey',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'logId',
          'visitorId',
          'sessionId',
          'isLoggedIn',
          'userEmail',
          'actionType',
          'language',
          'searchPremise',
          'generatedTitles',
          'selectedStoryTitle',
          'shotCount',
          'dayKey',
          'createdAt'
        ])
        && isValidId(data.logId)
        && data.logId == logId
        && isValidId(data.visitorId)
        && isValidId(data.sessionId)
        && data.isLoggedIn is bool
        && data.userEmail is string
        && data.userEmail.size() <= 128
        && (
          (!data.isLoggedIn && data.userEmail == '')
          || (data.isLoggedIn && isVerifiedUser() && data.userEmail.lower() == request.auth.token.email.lower())
        )
        && data.actionType is string
        && data.actionType.size() <= 16
        && data.actionType in ['angles', 'prompts']
        && data.language is string
        && data.language.size() <= 5
        && data.language in ['ml', 'en', 'hi', 'ta', 'kn', 'te']
        && data.searchPremise is string
        && data.searchPremise.size() >= 1
        && data.searchPremise.size() <= 5000
        && data.generatedTitles is list
        && data.generatedTitles.size() <= 20
        && (data.generatedTitles.size() == 0 || data.generatedTitles[0] is string)
        && data.selectedStoryTitle is string
        && data.selectedStoryTitle.size() <= 300
        && data.shotCount is int
        && data.shotCount >= 0
        && data.shotCount <= 2000
        && data.dayKey is string
        && data.dayKey.size() == 10
        && data.dayKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp;
    }

    // =========================================================================
    // 4. Collection Rules
    // =========================================================================

    // Anonymous guest visitor usage telemetry:
    match /visitor_sessions/{sessionId} {
      allow get: if isValidId(sessionId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow delete: if isValidId(sessionId) && isAdmin();

      allow create: if isValidId(sessionId)
        && isValidVisitorSession(incoming(), sessionId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().anglesGeneratedCount <= 10
        && incoming().breakdownsGeneratedCount <= 10
        && incoming().ttsPlaysCount <= 20;

      allow update: if isValidId(sessionId)
        && isValidVisitorSession(incoming(), sessionId)
        && (
          isAdmin()
          || (
            incoming().sessionId == existing().sessionId
            && incoming().visitorId == existing().visitorId
            && incoming().visitNumber == existing().visitNumber
            && incoming().isReturning == existing().isReturning
            && incoming().deviceType == existing().deviceType
            && incoming().screenCategory == existing().screenCategory
            && incoming().referrerSource == existing().referrerSource
            && incoming().dayKey == existing().dayKey
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().anglesGeneratedCount >= existing().anglesGeneratedCount
            && incoming().anglesGeneratedCount <= existing().anglesGeneratedCount + 10
            && incoming().breakdownsGeneratedCount >= existing().breakdownsGeneratedCount
            && incoming().breakdownsGeneratedCount <= existing().breakdownsGeneratedCount + 10
            && incoming().ttsPlaysCount >= existing().ttsPlaysCount
            && incoming().ttsPlaysCount <= existing().ttsPlaysCount + 20
            && incoming().activeDurationSec >= existing().activeDurationSec
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'language',
              'currentStep',
              'anglesGeneratedCount',
              'breakdownsGeneratedCount',
              'ttsPlaysCount',
              'activeDurationSec',
              'isLoggedIn',
              'userEmail',
              'updatedAt'
            ])
          )
        );
    }

    // Admin registry collection
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isBootstrappedAdmin() || (isVerifiedUser() && request.auth.uid == uid));
      allow list: if isBootstrappedAdmin();
      allow create: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming(), uid)
        && incoming().createdAt == request.time;
      allow update: if isBootstrappedAdmin()
        && isValidId(uid)
        && isValidAdminUser(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'role']);
      allow delete: if isBootstrappedAdmin() && isValidId(uid);
    }

    // Signed-in Google (Gmail) user accounts (PII isolated to Owner + Admin)
    match /user_accounts/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidUserAccount(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidUserAccount(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'loginCount',
          'savedStoriesCount',
          'lastDayKey',
          'lastLoginAt'
        ]);

      allow delete: if isValidId(uid) && (isOwner(uid) || isAdmin());

      // Auto-synced stories, ❤️ favorites & prompts saved to the user's Gmail account
      match /saved_stories/{storyId} {
        allow get: if isValidId(uid) && isValidId(storyId) && (isOwner(uid) || isAdmin());
        allow list: if isValidId(uid) && (
          isBootstrappedAdmin()
          || (isOwner(uid) && existing().ownerUid == request.auth.uid)
        );

        allow create: if isValidId(uid)
          && isValidId(storyId)
          && isOwner(uid)
          && isValidSavedStory(incoming(), uid, storyId)
          && exists(/databases/$(database)/documents/user_accounts/$(uid))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(uid)
          && isValidId(storyId)
          && isOwner(uid)
          && isValidSavedStory(incoming(), uid, storyId)
          && exists(/databases/$(database)/documents/user_accounts/$(uid))
          && incoming().storyId == existing().storyId
          && incoming().ownerUid == existing().ownerUid
          && incoming().ownerEmail == existing().ownerEmail
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title',
            'storySummary',
            'genre',
            'durationDisplay',
            'durationSeconds',
            'shotCount',
            'shots',
            'angle',
            'partNumber',
            'isAutoSaved',
            'isLoved',
            'savedAtMs',
            'updatedAt'
          ]);

        allow delete: if isValidId(uid) && isValidId(storyId) && (isOwner(uid) || isAdmin());
      }
    }

    // Append-only search premise & story/prompt generation activity logs (Admin-read only)
    match /generation_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(logId)
        && isValidGenerationLog(incoming(), logId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }
  }
}
