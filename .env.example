# GEMINI_API_KEY: Required server-side for Gemini AI API calls (configure in AI Studio Secrets or Vercel Environment Variables).
# Never expose GEMINI_API_KEY via VITE_ prefix to browser bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_API_BASE_URL: Optional backend origin if frontend on Vercel calls an external Express server
# (Leave empty when deploying with /api/* Vercel Serverless Functions or running server.ts directly).
VITE_API_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
