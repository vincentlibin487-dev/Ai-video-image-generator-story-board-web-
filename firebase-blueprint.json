{
  "entities": {
    "VisitorSession": {
      "title": "VisitorSession",
      "description": "Anonymous guest usage session tracked without requiring login so the admin can monitor visitor counts, language preferences, device mix, and story generation usage.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session identifier generated per browser tab session.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitorId": {
          "type": "string",
          "description": "Pseudonymous persistent visitor identifier stored in localStorage (no PII).",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitNumber": {
          "type": "integer",
          "description": "Sequential visit number for this browser visitor (1 for first-time visitors)."
        },
        "isReturning": {
          "type": "boolean",
          "description": "Whether this visitor had visited previously."
        },
        "language": {
          "type": "string",
          "description": "Active application language code.",
          "enum": ["ml", "en", "hi", "ta", "kn", "te"],
          "maxLength": 5
        },
        "deviceType": {
          "type": "string",
          "description": "Detected viewport category.",
          "enum": ["mobile", "tablet", "desktop"],
          "maxLength": 16
        },
        "screenCategory": {
          "type": "string",
          "description": "Rounded viewport dimensions category (e.g. 390x844).",
          "minLength": 3,
          "maxLength": 32
        },
        "referrerSource": {
          "type": "string",
          "description": "Sanitized referrer hostname or direct.",
          "minLength": 1,
          "maxLength": 64
        },
        "currentStep": {
          "type": "string",
          "description": "Latest page/step reached in the studio flow.",
          "enum": ["input", "options", "prompts", "editor", "admin"],
          "maxLength": 16
        },
        "anglesGeneratedCount": {
          "type": "integer",
          "description": "Number of story angle generations triggered in this session."
        },
        "breakdownsGeneratedCount": {
          "type": "integer",
          "description": "Number of full shot-breakdown prompt sets generated in this session."
        },
        "ttsPlaysCount": {
          "type": "integer",
          "description": "Number of voiceover story narrations played in this session."
        },
        "activeDurationSec": {
          "type": "integer",
          "description": "Approximate active engagement time in seconds."
        },
        "dayKey": {
          "type": "string",
          "description": "UTC/local calendar day string YYYY-MM-DD for daily analytics grouping.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "isLoggedIn": {
          "type": "boolean",
          "description": "Optional indicator whether this session signed into a Google account."
        },
        "userEmail": {
          "type": "string",
          "description": "Optional verified Google email for signed-in sessions (empty for guests).",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when session began."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest activity heartbeat or action."
        }
      },
      "required": [
        "sessionId",
        "visitorId",
        "visitNumber",
        "isReturning",
        "language",
        "deviceType",
        "screenCategory",
        "referrerSource",
        "currentStep",
        "anglesGeneratedCount",
        "breakdownsGeneratedCount",
        "ttsPlaysCount",
        "activeDurationSec",
        "dayKey",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator document granting dashboard access.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email address.",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Role identifier.",
          "enum": ["admin"],
          "maxLength": 16
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin entry was created."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Signed-in Google (Gmail) user profile stored so users can sync stories across devices and admins can monitor daily & total logged-in users.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Gmail address.",
          "minLength": 3,
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "User display name from Google profile.",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Google avatar URL.",
          "maxLength": 512
        },
        "loginCount": {
          "type": "integer",
          "description": "Cumulative login count for this account."
        },
        "savedStoriesCount": {
          "type": "integer",
          "description": "Current count of stories synced to this Gmail account."
        },
        "lastDayKey": {
          "type": "string",
          "description": "Local calendar day YYYY-MM-DD of the latest login.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user first signed in."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest login or sync."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "photoURL",
        "loginCount",
        "savedStoriesCount",
        "lastDayKey",
        "createdAt",
        "lastLoginAt"
      ]
    },
    "SavedUserStory": {
      "title": "SavedUserStory",
      "description": "Story, synopsis, angle metadata, and optional shot prompts automatically synced or favorited to the user's logged-in Gmail account.",
      "type": "object",
      "properties": {
        "storyId": {
          "type": "string",
          "description": "Unique saved story document ID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "description": "Owner verified Gmail address.",
          "minLength": 3,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Story title.",
          "minLength": 1,
          "maxLength": 300
        },
        "storySummary": {
          "type": "string",
          "description": "Story summary / synopsis.",
          "maxLength": 20000
        },
        "genre": {
          "type": "string",
          "description": "Genre label.",
          "maxLength": 120
        },
        "durationDisplay": {
          "type": "string",
          "description": "Formatted duration label.",
          "maxLength": 120
        },
        "durationSeconds": {
          "type": "integer",
          "description": "Total target film duration in seconds."
        },
        "shotCount": {
          "type": "integer",
          "description": "Number of shots generated (0 if favorited directly from story angle options)."
        },
        "shots": {
          "type": "array",
          "description": "Ordered list of generated shot objects with action, dialogue, imagePrompt, and videoPrompt."
        },
        "angle": {
          "type": "object",
          "description": "Full selected StoryAngle object."
        },
        "partNumber": {
          "type": "integer",
          "description": "Sequential chapter/part number."
        },
        "isAutoSaved": {
          "type": "boolean",
          "description": "Whether saved automatically upon prompt generation or heart favorite."
        },
        "isLoved": {
          "type": "boolean",
          "description": "Whether the user marked this story with the heart love icon."
        },
        "savedAtMs": {
          "type": "integer",
          "description": "Client epoch ms for sorting/display."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial save."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "storyId",
        "ownerUid",
        "ownerEmail",
        "title",
        "storySummary",
        "genre",
        "durationDisplay",
        "durationSeconds",
        "shotCount",
        "shots",
        "angle",
        "partNumber",
        "isAutoSaved",
        "savedAtMs",
        "createdAt",
        "updatedAt"
      ]
    },
    "GenerationLog": {
      "title": "GenerationLog",
      "description": "Admin-readable activity log recording user story searches/premises and generated story titles/prompts (for both guest and Gmail-logged-in users).",
      "type": "object",
      "properties": {
        "logId": {
          "type": "string",
          "description": "Unique generation log ID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitorId": {
          "type": "string",
          "description": "Visitor browser identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "Session identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isLoggedIn": {
          "type": "boolean",
          "description": "Whether generated while signed in with Google."
        },
        "userEmail": {
          "type": "string",
          "description": "Verified user Gmail if signed in, empty string if guest.",
          "maxLength": 128
        },
        "actionType": {
          "type": "string",
          "description": "Generation step triggered.",
          "enum": ["angles", "prompts"],
          "maxLength": 16
        },
        "language": {
          "type": "string",
          "description": "Language code used.",
          "enum": ["ml", "en", "hi", "ta", "kn", "te"],
          "maxLength": 5
        },
        "searchPremise": {
          "type": "string",
          "description": "User search/premise input text.",
          "minLength": 1,
          "maxLength": 5000
        },
        "generatedTitles": {
          "type": "array",
          "description": "Generated story angle titles (capped list)."
        },
        "selectedStoryTitle": {
          "type": "string",
          "description": "Selected story title when prompts are generated.",
          "maxLength": 300
        },
        "shotCount": {
          "type": "integer",
          "description": "Number of video/image shots generated."
        },
        "dayKey": {
          "type": "string",
          "description": "Local calendar day string YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of generation."
        }
      },
      "required": [
        "logId",
        "visitorId",
        "sessionId",
        "isLoggedIn",
        "userEmail",
        "actionType",
        "language",
        "searchPremise",
        "generatedTitles",
        "selectedStoryTitle",
        "shotCount",
        "dayKey",
        "createdAt"
      ]
    },
    "VideoEditLog": {
      "title": "VideoEditLog",
      "description": "Append-only video editor activity log recording editor opens, clip additions, timeline edits, and exports across guest and Gmail users.",
      "type": "object",
      "properties": {
        "editId": {
          "type": "string",
          "description": "Unique video edit log ID.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "visitorId": {
          "type": "string",
          "description": "Visitor browser identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "description": "Session identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "isLoggedIn": {
          "type": "boolean",
          "description": "Whether edited while signed in with Google."
        },
        "userEmail": {
          "type": "string",
          "description": "Verified user Gmail if signed in, empty string if guest.",
          "maxLength": 128
        },
        "actionType": {
          "type": "string",
          "description": "Video editor action performed.",
          "enum": ["open_editor", "add_media", "edit_timeline", "export_video"],
          "maxLength": 24
        },
        "projectTitle": {
          "type": "string",
          "description": "Project title inside the video editor.",
          "maxLength": 200
        },
        "clipCount": {
          "type": "integer",
          "description": "Number of timeline clips in the project."
        },
        "resolution": {
          "type": "string",
          "description": "Selected export resolution.",
          "enum": ["720p", "1080p", "4K"],
          "maxLength": 10
        },
        "aspectRatio": {
          "type": "string",
          "description": "Selected video aspect ratio.",
          "enum": ["16:9", "9:16", "1:1", "4:5", "21:9", "4:3"],
          "maxLength": 10
        },
        "exportDurationSec": {
          "type": "integer",
          "description": "Timeline duration in whole seconds."
        },
        "deviceType": {
          "type": "string",
          "description": "Detected viewport category.",
          "enum": ["mobile", "tablet", "desktop"],
          "maxLength": 16
        },
        "dayKey": {
          "type": "string",
          "description": "Local calendar day string YYYY-MM-DD.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the video editor event."
        }
      },
      "required": [
        "editId",
        "visitorId",
        "sessionId",
        "isLoggedIn",
        "userEmail",
        "actionType",
        "projectTitle",
        "clipCount",
        "resolution",
        "aspectRatio",
        "exportDurationSec",
        "deviceType",
        "dayKey",
        "createdAt"
      ]
    },
    "EditorConfigState": {
      "title": "EditorConfigState",
      "description": "Singleton initialization flags so deleted built-in categories or seeded music lyrics are not unexpectedly recreated.",
      "type": "object",
      "properties": {
        "configId": {
          "type": "string",
          "description": "Config document identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoriesInitialized": {
          "type": "boolean",
          "description": "Whether the default 14 wheel categories have been seeded into Firestore."
        },
        "musicLyricsInitialized": {
          "type": "boolean",
          "description": "Whether the initial 120 song lyrics have been seeded into Firestore."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest config update."
        }
      },
      "required": ["configId", "categoriesInitialized", "musicLyricsInitialized", "updatedAt"]
    },
    "EditorCategory": {
      "title": "EditorCategory",
      "description": "Dynamic editor wheel category persisted in Firestore and synced live to the video editor wheel and bottom panel.",
      "type": "object",
      "properties": {
        "categoryId": {
          "type": "string",
          "description": "Unique category identifier.",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "description": "Full display label.",
          "minLength": 1,
          "maxLength": 80
        },
        "shortLabel": {
          "type": "string",
          "description": "Compact wheel node label.",
          "minLength": 1,
          "maxLength": 24
        },
        "tab": {
          "type": "string",
          "description": "Associated editor tool tab key.",
          "minLength": 1,
          "maxLength": 32
        },
        "subCategory": {
          "type": "string",
          "description": "Optional default sub-category identifier.",
          "maxLength": 64
        },
        "trackNumber": {
          "type": "integer",
          "description": "Timeline track number."
        },
        "trackName": {
          "type": "string",
          "description": "Compact timeline track name.",
          "minLength": 1,
          "maxLength": 40
        },
        "accentHex": {
          "type": "string",
          "description": "Hex accent color (#RRGGBB).",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "iconKey": {
          "type": "string",
          "description": "Lucide icon identifier key.",
          "minLength": 1,
          "maxLength": 32
        },
        "orderIndex": {
          "type": "integer",
          "description": "Display order index."
        },
        "isBuiltIn": {
          "type": "boolean",
          "description": "Whether this category corresponds to one of the original 14 wheel tools."
        },
        "hasLyricsBoxes": {
          "type": "boolean",
          "description": "Whether items in this category render as individual copyable lyrics/text boxes."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when category was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "categoryId",
        "label",
        "shortLabel",
        "tab",
        "subCategory",
        "trackNumber",
        "trackName",
        "accentHex",
        "iconKey",
        "orderIndex",
        "isBuiltIn",
        "hasLyricsBoxes",
        "createdAt",
        "updatedAt"
      ]
    },
    "CategoryContentItem": {
      "title": "CategoryContentItem",
      "description": "Individual song lyrics or custom preset box belonging to an EditorCategory.",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "description": "Unique item identifier.",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "categoryId": {
          "type": "string",
          "description": "Parent EditorCategory ID.",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Song or item box title.",
          "minLength": 1,
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "description": "Mood, artist, or short tag.",
          "maxLength": 160
        },
        "lyrics": {
          "type": "string",
          "description": "Full copyable song lyrics or text snippet.",
          "maxLength": 8000
        },
        "badgeText": {
          "type": "string",
          "description": "Optional short label badge.",
          "maxLength": 40
        },
        "orderIndex": {
          "type": "integer",
          "description": "Display order index within category."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when item was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        }
      },
      "required": [
        "itemId",
        "categoryId",
        "title",
        "subtitle",
        "lyrics",
        "badgeText",
        "orderIndex",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/visitor_sessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/VisitorSession"
      },
      "description": "Write-only for unauthenticated guest sessions; read, list, and delete strictly restricted to verified admins."
    },
    "/admins/{uid}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Admin access registry strictly controlled by verified admin accounts."
    },
    "/user_accounts/{uid}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Google signed-in user accounts; owner can read/write own profile, admin can list/monitor daily and total Gmail logins."
    },
    "/user_accounts/{uid}/saved_stories/{storyId}": {
      "schema": {
        "$ref": "#/entities/SavedUserStory"
      },
      "description": "Stories, ❤️ favorites, and prompts synced directly to the signed-in user's Gmail account."
    },
    "/generation_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/GenerationLog"
      },
      "description": "Append-only user search premise and generated story/prompt logs readable only by the verified admin."
    },
    "/video_edit_logs/{editId}": {
      "schema": {
        "$ref": "#/entities/VideoEditLog"
      },
      "description": "Append-only video editor usage and export activity logs across guests and Gmail users, readable only by the verified admin."
    },
    "/editor_config/{configId}": {
      "schema": {
        "$ref": "#/entities/EditorConfigState"
      },
      "description": "Editor initialization flags readable by clients and writable strictly by verified admins."
    },
    "/editor_categories/{categoryId}": {
      "schema": {
        "$ref": "#/entities/EditorCategory"
      },
      "description": "Public dynamic editor wheel categories managed strictly by verified admins."
    },
    "/category_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/CategoryContentItem"
      },
      "description": "Public copyable song lyrics and custom category items managed strictly by verified admins."
    }
  }
}
